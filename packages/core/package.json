{
  "name": "@agent-aggregator/core",
  "version": "0.2.1",
  "description": "Protocol, storage and security core for aggregating personal AI agents: work items, checkpoints, questions, answers and handoff jobs over REST, MCP (2025 and 2026-07-28) and signed webhooks.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./postgres": {
      "types": "./dist/stores/postgres.d.ts",
      "import": "./dist/stores/postgres.js"
    },
    "./sqlite": {
      "types": "./dist/stores/sqlite.d.ts",
      "import": "./dist/stores/sqlite.js"
    },
    "./cli": {
      "types": "./dist/cli.d.ts",
      "import": "./dist/cli.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --experimental-sqlite tests/*.test.mjs"
  },
  "sideEffects": false,
  "devDependencies": {
    "@types/node": "^26.6.4",
    "postgres": "^3.4.7",
    "typescript": "^5.9.3"
  }
}
